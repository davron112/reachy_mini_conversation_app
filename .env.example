# Optional realtime input transcription language.
# Defaults to "auto" for automatic language detection. Set to "en" for English or "zh" for Chinese to fix the language.
# REALTIME_TRANSCRIPTION_LANGUAGE="auto"

# Local Silero VAD supplements server VAD for antenna freeze and idle movement.
# Defaults to true; saved Settings → Speech behavior choices override this value.
# LOCAL_VAD_ENABLED=true

# Local barge-in: duck playback on possible speech until server VAD confirms the turn. Requires local VAD.
# Defaults to true; editable from Settings → Speech behavior.
# LOCAL_BARGE_IN_ENABLED=true

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not enabled by the selected profile or its Tool access override.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# Directory holding this instance's data: long-term memory, user personalities and settings.
# Defaults to a conversation_app folder beside the daemon's own config (~/.config/reachy_mini).
# Set it in the process environment: the instance .env lives inside that
# directory, so a value written there is read too late to take effect.
# REACHY_MINI_INSTANCE_PATH=~/reachy-mini-data

# Long-term memory: remembered facts are injected into the prompt and the
# remember/forget tools work. Turning it off keeps the stored facts. Default true.
# REACHY_MINI_MEMORY_ENABLED=true

# Camera tool. --no-camera still forces it off whatever this says. Default true.
# REACHY_MINI_CAMERA_ENABLED=true

# === Music subsystem ===
# Backend selection: auto (default), yandex, or local.
# REACHY_MUSIC_BACKEND=auto

# Yandex Music OAuth token (used when REACHY_MUSIC_BACKEND=yandex or auto-detected).
# Obtain by visiting:
# https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
# The token appears in the redirect URL after `#access_token=`.
# Requires an active Yandex Plus subscription for full-length streams.
# YANDEX_MUSIC_TOKEN=

# Directory holding local audio files (used for the local backend and fallback).
# REACHY_LOCAL_MUSIC_DIR=~/Music/reachy_mini

# Preferred audio player: mpv, vlc, or auto. Defaults to auto-detect.
# REACHY_MUSIC_PLAYER=auto

# Volume (0..100) the music player drops to while the assistant is speaking.
# REACHY_MUSIC_DUCK_VOLUME=25

# === MCP bridge ===
# Remote MCP servers (streamable HTTP transport; HTTPS, or plain HTTP on localhost only).
# Tools are discovered at startup and exposed to the LLM as `<server>__<tool>`; server names
# must match [A-Za-z_][A-Za-z0-9_]*. A profile only gets them when its profile.md default_tools
# opts in: `mcp:*` (all), `mcp:<server>`, `mcp:<server>/<tool>` or `mcp:*/<tool>`.
# Built-in tool names always win over MCP tools on collision.

# Single server (name defaults to "mcp", so tools appear as mcp__<tool>)
# MCP_SERVER_URL=https://your-server.example/mcp
# MCP_SERVER_NAME=mcp
# MCP_API_KEY=
# Optional JSON of extra request headers
# MCP_EXTRA_HEADERS={"X-Tenant":"reachy"}

# Several servers: JSON list; api_key_env names the env var holding that server's bearer key
# MCP_SERVERS=[{"name":"home","url":"http://127.0.0.1:8100/mcp","api_key_env":"HOME_MCP_KEY","headers":{"X-Tenant":"reachy"}}]

# Per-server discovery timeout at startup (default 5); servers are queried in parallel
# MCP_DISCOVERY_TIMEOUT_S=5
# Per tool call timeout (default 30)
# MCP_CALL_TIMEOUT_S=30

# === Wake word ===
# Master switch: 1 to enable on-device wake-word listening, blank/0 to disable.
# REACHY_WAKE_WORD_ENABLED=1

# Engine: "vosk" (recommended, custom phrase via config) or "openwakeword" (legacy, pre-trained .onnx).
# REACHY_WAKE_WORD_ENGINE=vosk

# Cooldown after a successful fire (seconds) — prevents back-to-back triggers.
# REACHY_WAKE_WORD_COOLDOWN_S=2.0

# How long the assistant stays in "actively listening" mode after a wake (seconds).
# REACHY_WAKE_ACTIVE_WINDOW_S=12

# --- Vosk backend ---
# Comma-separated phrases the recognizer is restricted to. Include common
# child mispronunciations (e.g. "huli", "guli guli") to improve recall.
# REACHY_WAKE_WORD_PHRASES=hey guli,guli,ey guli,hi guli,huli,guli guli

# Vosk model directory. Download a small model (~50MB) from https://alphacephei.com/vosk/models
# Recommended: vosk-model-small-en-us-0.15 (English, 40MB).
# REACHY_WAKE_WORD_VOSK_MODEL=models/vosk-model-small-en-us-0.15

# Vosk internal log level (-1 disables, 0 minimal, higher = verbose).
# REACHY_WAKE_WORD_VOSK_LOG_LEVEL=-1

# --- openWakeWord backend (legacy) ---
# Path to the .onnx wake-word model (pre-trained or custom-trained).
# REACHY_WAKE_WORD_MODEL=/path/to/openwakeword/resources/models/hey_jarvis_v0.1.onnx
# Score threshold (0.0-1.0). Lower = more sensitive but more false positives.
# REACHY_WAKE_WORD_THRESHOLD=0.5
# Inference framework: "onnx" (default) or "tflite".
# REACHY_WAKE_WORD_FRAMEWORK=onnx

# === Microphone ===
# Software gain applied to mic frames for every backend (1.0 = unchanged). Reachy Mini mic is quiet: 2.5-3.0.
# REACHY_MIC_GAIN=1.0
# Stereo downmix: absmax (louder channel per sample), mean, first, second.
# REACHY_MIC_CHANNEL_MIX=absmax
# Half-duplex: mute the mic while the robot speaks so it never hears itself (no AEC on the direct ALSA path).
# While it is on, local barge-in (LOCAL_BARGE_IN_ENABLED) cannot hear the user over the robot; set 0 to use it.
# REACHY_HALF_DUPLEX=1
# Extra seconds the mic stays muted after playback for room echo.
# REACHY_ECHO_TAIL_S=0.5
# Let new speech cancel a pending/playing reply (barge-in). Disable in noisy rooms.
# REALTIME_INTERRUPT_RESPONSE=1
# Capture the mic straight from the daemon's ALSA dsnoop device instead of the SDK pipeline.
# Required for the wake word, which only listens on this path.
# REACHY_DIRECT_ALSA_MIC=0
# REACHY_ALSA_MIC_DEVICE=reachymini_audio_src
# REACHY_ALSA_MIC_RATE=16000
# REACHY_ALSA_MIC_CHANNELS=2
# SDK media backend requested by the app.
# REACHY_MEDIA_BACKEND=local
